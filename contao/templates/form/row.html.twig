{#
    This component outputs the wrapper around a single field, together with its
    label, its errors, the widget itself and the help text.

        <div class="form-row form-row--email">
          <label …>…</label>
          <input …>
          <ul class="form-errors">…</ul>
          <p class="form-help">…</p>
        </div>

    The "block_prefixes" variable holds the type chain of the field, for
    example ['form', 'text', 'email', '_f_email']. The entry before the last
    one is the type of the field itself and is used as a modifier class.

    Mandatory variables:
        @var \Symfony\Component\Form\FormView form
        @var array block_prefixes

    Optional variables:
        @var array row_attr
        @var array widget_attr
        @var \Contao\CoreBundle\String\HtmlAttributes row_attributes
#}

{# The field's own type is the entry before Symfony's unique per-field prefix #}
{% set field_type = block_prefixes|slice(-2, 1)|first|replace({_: '-'}) %}

{% set row_attributes = attrs()
    .addClass('form-row')
    .addClass("form-row--#{field_type}")
    .mergeWith(row_attr|default)
    .mergeWith(row_attributes|default)
%}

<div{% block row_attributes %}{{ row_attributes }}{% endblock %}>
    {%- block row_label %}{{ form_label(form) }}{% endblock -%}
    {%- block row_widget %}{{ form_widget(form, widget_attr|default({})) }}{% endblock -%}
    {%- block row_errors %}{{ form_errors(form) }}{% endblock -%}
    {%- block row_help %}{{ form_help(form) }}{% endblock -%}
</div>
